<section id="<%= dom_id %>" class="space-y-2">
  <h3 class="font-semibold">
    <%= t("subject_progresses.picker.title") %>
  </h3>
  <div role="group" aria-label="<%= t("subject_progresses.picker.label") %>" class="flex flex-wrap gap-2">
    <% SubjectProgress.statuses.each_key do |candidate| %>
      <%= button_to subject_progress_path(subject), method: :patch, params: { status: candidate }, form: { class: "contents" }, class: button_class(candidate), aria: { pressed: pressed?(candidate) } do %>
        <% if pressed?(candidate) %>
          <span aria-hidden="true">
            ✓
          </span>
        <% end %>
        <%= t("subject_progresses.statuses.#{candidate}") %>
      <% end %>
    <% end %>
  </div>
  <% if show_missing? %>
    <div class="alert alert-warning alert-soft flex-col items-start gap-1 text-sm" role="note">
      <p>
        <%= t("subject_progresses.picker.missing") %>
      </p>
      <ul class="list-disc pl-5">
        <% missing.each do |required| %>
          <li>
            <%= link_to required.name, subject_path(required), class: "link" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
