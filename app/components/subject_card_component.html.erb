<%= link_to subject_path(subject), data: { turbo_frame: "subject_detail", subject_id: subject.id, required_ids: required_ids.join(" "), grid_highlight_target: "card", action: "click->grid-highlight#toggle" }, class: "block rounded-box border border-base-300 bg-base-100 px-3 py-2 text-sm motion-safe:transition-colors hover:border-primary hover:bg-base-200 group data-[highlight=selected]:border-primary data-[highlight=selected]:bg-base-200 data-[highlight=requires]:border-secondary data-[highlight=unlocks]:border-accent data-[highlight=unlocks]:border-dashed" do %>
  <span class="block font-medium">
    <%= subject.name %>
  </span>
  <span class="block text-xs text-base-content/70">
    <%= subject.code %>
  </span>
  <span class="hidden group-data-[highlight=requires]:block">
    <span class="badge badge-secondary badge-sm">
      <%= t("study_plans.grid.relation.requires") %>
    </span>
  </span>
  <span class="hidden group-data-[highlight=unlocks]:block">
    <span class="badge badge-accent badge-sm">
      <%= t("study_plans.grid.relation.unlocks") %>
    </span>
  </span>
<% end %>
