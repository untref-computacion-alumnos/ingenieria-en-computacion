<%= link_to subject_path(subject), data: { turbo_frame: "subject_detail", subject_id: subject.id, required_ids: required_ids.join(" "), grid_highlight_target: "card", action: "click->grid-highlight#toggle focusin->grid-highlight#preview focusout->grid-highlight#endPreview" }, class: "block rounded-box border border-base-300 bg-base-100 px-3 py-2 text-sm motion-safe:transition-colors hover:border-primary hover:bg-base-200 group data-[highlight=selected]:border-primary data-[highlight=selected]:bg-base-200 data-[highlight=requires]:border-secondary data-[highlight=unlocks]:border-accent data-[highlight=unlocks]:border-dashed border-l-4 has-[[data-status=pending]]:border-l-status-pending has-[[data-status=in_progress]]:border-l-status-in-progress has-[[data-status=regular]]:border-l-status-regular has-[[data-status=approved]]:border-l-status-approved has-[[data-status=promoted]]:border-l-status-promoted" do %>
  <span class="block font-medium">
    <%= subject.name %>
  </span>
  <span class="block text-xs text-base-content/70">
    <%= subject.code %>
  </span>
  <span class="hidden group-data-[highlight=requires]:block">
    <span class="badge badge-secondary badge-sm">
      <%= t("study_plans.grid.relation.requires") %>
    </span>
  </span>
  <% if status %>
    <%= render SubjectStatusBadgeComponent.new(subject: subject, status: status) %>
  <% end %>
  <span class="hidden group-data-[highlight=unlocks]:block">
    <span class="badge badge-accent badge-sm">
      <%= t("study_plans.grid.relation.unlocks") %>
    </span>
  </span>
<% end %>
