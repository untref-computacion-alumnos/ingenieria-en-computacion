<div class="overflow-x-auto" data-controller="grid-highlight">
  <div class="flex gap-3">
    <% subjects_by_term.each do |(year, term), subjects| %>
      <section class="min-w-48 space-y-2">
        <h2 class="text-sm font-semibold">
          <%= t("study_plans.grid.term", year: year, term: term) %>
        </h2>
        <% subjects.each do |subject| %>
          <%= render SubjectCardComponent.new(subject: subject) %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
