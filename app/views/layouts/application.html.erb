<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="font-sans">
    <a href="#main" class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-30">
      <%= t("app.skip_to_content") %>
    </a>
    <header class="border-b border-base-300">
      <nav aria-label="<%= t("layouts.account.label") %>" class="container mx-auto flex items-center justify-between gap-3 px-5 py-2">
        <%= link_to t("app.name"), root_path, class: "font-bold" %>
        <% if user_signed_in? %>
          <div class="flex items-center gap-3">
            <span class="text-sm"><%= current_user.email %></span>
            <%= button_to t("layouts.account.sign_out"), destroy_user_session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          </div>
        <% else %>
          <%= link_to t("layouts.account.sign_up"), new_user_registration_path, class: "btn btn-primary btn-sm" %>
        <% end %>
      </nav>
    </header>
    <main id="main" class="container mx-auto px-5">
      <%= yield %>
    </main>
  </body>
</html>
