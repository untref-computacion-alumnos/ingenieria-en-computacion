<% badges.each do |item, display_status| %>
  <%= turbo_stream.replace ActionView::RecordIdentifier.dom_id(subject, :status), SubjectStatusBadgeComponent.new(subject: item, status: display_status) %>
<% end %>
<%= turbo_stream.replace ActionView::RecordIdentifier.dom_id(subject, :status_picker), SubjectStatusPickerComponent.new(subject: subject, status: status, missing: missing) %>
