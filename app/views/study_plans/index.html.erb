<h1 class="text-3xl font-bold py-6"><%= t(".title") %></h1>
<ul class="space-y-4">
  <% @study_plans.each do |study_plan| %>
    <li>
      <%= t("study_plans.card.title", year: study_plan.year) %>
      <%= t("study_plans.card.subjects", count: study_plan.subjects_count) %>
    </li>
  <% end %>
</ul>
