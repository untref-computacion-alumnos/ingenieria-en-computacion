<h1 class="text-3xl font-bold py-6">
  <%= t(".title", year: @study_plan.year) %>
</h1>
<% @subjects_by_term.each do |(year, term), subjects| %>
  <section>
    <h2>
      <%= t("study_plans.grid.term", year: year, term: term) %>
    </h2>
    <% subjects.each do |subject| %>
      <%= render SubjectCardComponent.new(name: subject.name) %>
    <% end %>
  </section>
<% end %>
