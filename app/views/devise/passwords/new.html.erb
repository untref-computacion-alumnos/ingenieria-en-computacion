<div class="mx-auto max-w-md py-6">
  <h1 class="text-3xl font-bold pb-4">
    <%= t(".forgot_your_password") %>
  </h1>
  <%= form_with(model: resource, scope: resource_name, url: password_path(resource_name), method: :post, class: "space-y-4") do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <fieldset class="fieldset">
      <%= f.label :email, class: "fieldset-legend" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input w-full" %>
    </fieldset>
    <%= f.submit t(".send_me_reset_password_instructions"), class: "btn btn-primary w-full" %>
  <% end %>
</div>
