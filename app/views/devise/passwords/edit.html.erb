<div class="mx-auto max-w-md py-6">
  <h1 class="text-3xl font-bold pb-4">
    <%= t(".change_your_password") %>
  </h1>
  <%= form_with(model: resource, scope: resource_name, url: password_path(resource_name), method: :put, class: "space-y-4") do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <fieldset class="fieldset">
      <%= f.label :password, t(".new_password"), class: "fieldset-legend" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, aria: { describedby: "password_hint" }, class: "input w-full" %>
      <% if @minimum_password_length %>
        <p id="password_hint" class="label">
          <%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %>
        </p>
      <% end %>
    </fieldset>
    <fieldset class="fieldset">
      <%= f.label :password_confirmation, t(".confirm_new_password"), class: "fieldset-legend" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "input w-full" %>
    </fieldset>
    <%= f.submit t(".change_my_password"), class: "btn btn-primary w-full" %>
  <% end %>
</div>
