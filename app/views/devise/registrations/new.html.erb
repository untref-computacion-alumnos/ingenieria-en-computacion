<div class="mx-auto max-w-md py-6">
  <h1 class="text-3xl font-bold pb-4">
    <%= t(".sign_up") %>
  </h1>
  <%= form_with(model: resource, scope: resource_name, url: registration_path(resource_name), class: "space-y-4") do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <fieldset class="fieldset">
      <%= f.label :email, class: "fieldset-legend" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input w-full" %>
    </fieldset>
    <fieldset class="fieldset">
      <%= f.label :password, class: "fieldset-legend" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, aria: { describedby: "password_hint" }, class: "input w-full" %>
      <% if @minimum_password_length %>
        <p id="password_hint" class="label">
          <%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %>
        </p>
      <% end %>
    </fieldset>
    <fieldset class="fieldset">
      <%= f.label :password_confirmation, class: "fieldset-legend" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "input w-full" %>
    </fieldset>
    <%= f.submit t(".sign_up"), class: "btn btn-primary w-full" %>
  <% end %>
</div>
