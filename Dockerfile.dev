ARG RUBY_VERSION=4.0.9
FROM ruby:${RUBY_VERSION}-slim
RUN apt-get update -qq && apt-get install -y --no-install-recommends build-essential git curl libpq-dev libyaml-dev pkg-config postgresql-client chromium yamllint nodejs npm && rm -rf /var/lib/apt/lists/*
RUN npm install -g markdownlint-cli2 @commitlint/cli
WORKDIR /rails
COPY Gemfile Gemfile.lock ./
RUN bundle install
