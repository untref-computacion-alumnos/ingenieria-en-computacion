extends: default

rules:
  line-length: disable
  document-start: disable
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  indentation:
    indent-sequences: consistent
  comments-indentation: disable
  truthy:
    check-keys: false

ignore: |
  node_modules/
  vendor/
  config/cucumber.yml
